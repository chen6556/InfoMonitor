QObject[Transparent = true]
{
    border: none;
    background: transparent;
}

QObject[WhiteBackground = true]
{
    background-color: rgb(251, 251, 251);
}

Element
{
    background-color: rgb(240, 240, 240);
    border: 1px solid black;
    border-radius: 10px;
}

Element QWidget
{
    border: 1px solid black;
    border-radius: 10px;
    font-size: 16px;
}

QListWidget, QListView
{
    background-color: rgb(251, 251, 251);
    border: 1px solid black;
    border-radius: 15px;
    font-size: 16px;
}

QLabel
{
    background-color: rgb(251, 251, 251);
}

